generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  SUPER_ADMIN
  AGENCY_ADMIN
  BRANCH_ADMIN
  AGENT
}

enum BusType {
  SEATER
  SLEEPER
  SEATER_SLEEPER
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PointType {
  BOARDING
  DROP_OFF
  BOTH
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum FinanceMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  OTHER
}

enum SettlementParty {
  AGENT
  OPERATOR
}

enum LedgerType {
  PAYMENT
  REFUND
  COMMISSION
  COMMISSION_REVERSAL
  SETTLEMENT
  OPERATOR_PAYABLE
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  roleId                  String
  agencyId                String?
  branchId                String?
  status                  RecordStatus             @default(ACTIVE)
  onboardingCompleted     Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    Role                     @relation(fields: [roleId], references: [id])
  agency                  Agency?                  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  branch                  Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  passwordResetOtps       PasswordResetOtp[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         Invitation[]             @relation("SentInvitations")
  receivedInvitation      Invitation?              @relation("InvitedUser")
  agentCommissions        AgentCommission[]

  @@index([agencyId])
  @@index([branchId])
}

model Agency {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  country           String?
  status            RecordStatus       @default(ACTIVE)
  maxDiscountType   DiscountType       @default(PERCENTAGE)
  maxDiscountValue  Decimal            @default(0) @db.Decimal(10, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  branches          Branch[]
  buses             Bus[]
  drivers           Driver[]
  routes            Route[]
  trips             Trip[]
  invitations       Invitation[]
  bookings          Booking[]
  financeSettings   FinanceSettings?
  cancellationTiers CancellationTier[]
  financeLedgers    FinanceLedger[]
  settlements       Settlement[]
  paymentRecords    PaymentRecord[]
  refundRecords     RefundRecord[]
  agentCommissions  AgentCommission[]
}

model Branch {
  id          String       @id @default(cuid())
  agencyId    String
  name        String
  code        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]
  buses       Bus[]
  drivers     Driver[]
  trips       Trip[]

  @@unique([agencyId, code])
  @@index([agencyId])
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  users       User[]
  permissions RolePermission[]
  invitations Invitation[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Bus {
  id                 String         @id @default(cuid())
  agencyId           String
  branchId           String
  registrationNumber String
  busNumber          String
  operatorName       String?
  busType            BusType
  totalSeats         Int
  make               String?
  model              String?
  year               Int?
  color              String?
  description        String?
  amenities          String[]       @default([])
  photos             String[]       @default([])
  status             RecordStatus   @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  agency             Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trips              Trip[]
  seatLayout         BusSeatLayout?

  @@unique([agencyId, registrationNumber])
  @@unique([agencyId, busNumber])
  @@index([agencyId, branchId])
  @@index([status])
}

model Driver {
  id                String       @id @default(cuid())
  agencyId          String
  branchId          String
  firstName         String
  lastName          String
  phone             String
  email             String?
  licenseNumber     String
  licenseExpiryDate DateTime?
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  agency            Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trips             Trip[]

  @@unique([agencyId, licenseNumber])
  @@index([agencyId, branchId])
  @@index([status])
}

model Route {
  id          String       @id @default(cuid())
  agencyId    String
  name        String
  code        String
  source      String
  destination String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  stops       Stop[]
  trips       Trip[]

  @@unique([agencyId, code])
  @@index([agencyId, status])
}

model Stop {
  id                         String          @id @default(cuid())
  routeId                    String
  name                       String
  address                    String?
  city                       String?
  latitude                   Decimal?        @db.Decimal(10, 7)
  longitude                  Decimal?        @db.Decimal(10, 7)
  sequence                   Int
  estimatedMinutesFromOrigin Int?
  status                     RecordStatus    @default(ACTIVE)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  route                      Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  points                     BoardingPoint[]
  boardingBookings           Booking[]       @relation("BookingBoardingStop")
  dropOffBookings            Booking[]       @relation("BookingDropOffStop")

  @@unique([routeId, sequence])
  @@index([routeId, status])
}

model BoardingPoint {
  id         String       @id @default(cuid())
  stopId     String
  pointType  PointType
  timeOffset Int?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  stop       Stop         @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([stopId, pointType])
  @@index([stopId, status])
}

model Trip {
  id            String     @id @default(cuid())
  agencyId      String
  branchId      String
  routeId       String
  busId         String
  driverId      String
  tripCode      String
  travelDate    DateTime   @db.Date
  departureTime DateTime
  arrivalTime   DateTime
  status        TripStatus @default(SCHEDULED)
  fare          Decimal    @default(0) @db.Decimal(10, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  agency        Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  route         Route      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus           Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  driver        Driver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  seats         TripSeat[]
  bookings      Booking[]

  @@unique([agencyId, tripCode])
  @@index([agencyId, travelDate])
  @@index([busId, departureTime, arrivalTime])
  @@index([driverId, departureTime, arrivalTime])
  @@index([branchId, status])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([userId, expiresAt])
}

model BusSeatLayout {
  id            String   @id @default(cuid())
  busId         String   @unique
  rows          Int
  columns       Int
  disabledSeats String[] @default([])
  seatDetails   Json     @default("{}")
  updatedAt     DateTime @updatedAt
  bus           Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
}

model TripSeat {
  id            String         @id @default(cuid())
  tripId        String
  seatName      String
  status        TripSeatStatus @default(AVAILABLE)
  holdToken     String?
  heldById      String?
  holdExpiresAt DateTime?
  bookingId     String?
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tripId, seatName])
  @@index([tripId, status, holdExpiresAt])
  @@index([holdToken])
  @@index([bookingId])
}

model Booking {
  id               String               @id @default(cuid())
  pnr              String               @unique
  idempotencyKey   String               @unique
  holdToken        String               @unique
  agencyId         String
  branchId         String
  tripId           String
  bookedById       String
  boardingStopId   String
  dropOffStopId    String
  status           BookingStatus        @default(CONFIRMED)
  currency         String               @default("INR")
  baseFare         Decimal              @db.Decimal(10, 2)
  discountType     DiscountType?
  discountValue    Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal              @db.Decimal(10, 2)
  taxRate          Decimal              @default(0) @db.Decimal(7, 4)
  taxAmount        Decimal              @default(0) @db.Decimal(10, 2)
  commissionType   DiscountType?
  commissionRate   Decimal              @default(0) @db.Decimal(10, 2)
  commissionAmount Decimal              @default(0) @db.Decimal(10, 2)
  cancellationFee  Decimal              @default(0) @db.Decimal(10, 2)
  createdAt        DateTime             @default(now())
  agency           Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  trip             Trip                 @relation(fields: [tripId], references: [id], onDelete: Restrict)
  boardingStop     Stop                 @relation("BookingBoardingStop", fields: [boardingStopId], references: [id], onDelete: Restrict)
  dropOffStop      Stop                 @relation("BookingDropOffStop", fields: [dropOffStopId], references: [id], onDelete: Restrict)
  passengers       BookingPassenger[]
  seats            TripSeat[]
  payments         PaymentRecord[]
  refunds          RefundRecord[]
  commission       AgentCommission?
  ledgerEntries    FinanceLedger[]
  cancellation     BookingCancellation?

  @@index([agencyId, createdAt])
  @@index([branchId, createdAt])
  @@index([tripId, status])
}

model BookingPassenger {
  id                String  @id @default(cuid())
  bookingId         String
  seatName          String
  firstName         String
  lastName          String
  age               Int
  gender            String
  phone             String
  email             String?
  documentType      String?
  documentReference String?
  booking           Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatName])
  @@index([phone])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  userId      String    @unique
  agencyId    String
  branchId    String?
  roleId      String
  invitedById String
  email       String
  firstName   String
  lastName    String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email, createdAt])
  @@index([agencyId, createdAt])
}

model FinanceSettings {
  agencyId         String       @id
  gstRate          Decimal      @default(0) @db.Decimal(7, 4)
  gstAfterDiscount Boolean      @default(true)
  commissionType   DiscountType @default(PERCENTAGE)
  commissionValue  Decimal      @default(0) @db.Decimal(10, 2)
  agency           Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  updatedAt        DateTime     @updatedAt
}

model CancellationTier {
  id                   String  @id @default(cuid())
  agencyId             String
  hoursBeforeDeparture Decimal @db.Decimal(8, 2)
  feePercent           Decimal @db.Decimal(7, 4)
  agency               Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, hoursBeforeDeparture])
  @@index([agencyId, hoursBeforeDeparture])
}

model PaymentRecord {
  id           String        @id @default(cuid())
  bookingId    String
  agencyId     String
  amount       Decimal       @db.Decimal(10, 2)
  method       FinanceMethod
  reference    String?
  receivedAt   DateTime      @default(now())
  recordedById String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId, receivedAt])
  @@index([bookingId, receivedAt])
}

model RefundRecord {
  id           String        @id @default(cuid())
  bookingId    String
  agencyId     String
  amount       Decimal       @db.Decimal(10, 2)
  method       FinanceMethod
  reference    String?
  refundedAt   DateTime      @default(now())
  recordedById String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId, refundedAt])
  @@index([bookingId, refundedAt])
}

model BookingCancellation {
  bookingId      String   @id
  eligibleRefund Decimal  @db.Decimal(10, 2)
  feeAmount      Decimal  @db.Decimal(10, 2)
  cancelledById  String
  cancelledAt    DateTime @default(now())
  reason         String?
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model AgentCommission {
  bookingId      String  @id
  agencyId       String
  agentId        String
  amount         Decimal @db.Decimal(10, 2)
  reversedAmount Decimal @default(0) @db.Decimal(10, 2)
  agency         Agency  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  agent          User    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agencyId, agentId])
}

model Settlement {
  id           String          @id @default(cuid())
  agencyId     String
  party        SettlementParty
  partyId      String
  amount       Decimal         @db.Decimal(10, 2)
  method       FinanceMethod
  reference    String?
  settledAt    DateTime        @default(now())
  recordedById String
  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId, party, partyId, settledAt])
}

model FinanceLedger {
  id          String           @id @default(cuid())
  agencyId    String
  bookingId   String?
  type        LedgerType
  party       SettlementParty?
  partyId     String?
  amount      Decimal          @db.Decimal(10, 2)
  description String
  createdAt   DateTime         @default(now())
  agency      Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt])
  @@index([bookingId, createdAt])
}
