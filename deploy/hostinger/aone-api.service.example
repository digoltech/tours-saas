[Unit]
Description=A-One Tours API
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=aone
Group=aone
WorkingDirectory=/srv/a-one-tours
EnvironmentFile=/etc/a-one-tours/api.env
ExecStart=/usr/local/bin/bun apps/api/src/server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/a-one-tours/supabase-ca.crt
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
