DATABASE_URL="postgresql://runtime_user:[PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres?sslmode=verify-full&sslrootcert=/etc/a-one-tours/supabase-ca.crt"
DIRECT_URL="postgresql://migration_user:[PASSWORD]@[DIRECT-OR-SESSION-HOST]:5432/postgres?sslmode=verify-full&sslrootcert=/etc/a-one-tours/supabase-ca.crt"
PORT=4000
NODE_ENV=development
JWT_SECRET="replace-with-at-least-32-random-characters"
WEB_URL="http://localhost:3000"
REDIS_URL="redis://127.0.0.1:6379"
RESEND_API_KEY="re_your_resend_api_key"
MAIL_FROM="A-One Tours <onboarding@your-verified-domain.com>"
SMS_PROVIDER_URL="https://provider.example/messages"
SMS_PROVIDER_TOKEN=""
WHATSAPP_PROVIDER_URL="https://provider.example/messages"
WHATSAPP_PROVIDER_TOKEN=""
